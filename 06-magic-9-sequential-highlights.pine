// Source: https://www.tradingview.com/script/h92KjsEI-blackcat-L3-Magic-9-Sequential-within-Highlights/
//@version=6
indicator('[blackcat] L3 Magic-9 Sequential within Highlights', overlay = true, max_bars_back = 4000, max_labels_count = 500)

// Group name constants (const string)
var string GRP_SEQ = 'Magic-9 Sequential'
var string GRP_HL  = 'Magic-9 Highlights'
var string GRP_SIG = 'Signal Governance'
var string GRP_RSK = 'Risk (ATR TP/SL)'
var string GRP_VIS = 'Visual'

// Color semantic constants
color C_LONG    = color.new(color.green, 50)
color C_SHORT   = color.new(color.red, 50)
color C_EXIT    = color.new(color.orange, 0)
color C_REL     = color.new(color.teal, 0)
color C_RES     = color.new(color.maroon, 0)
color C_BGLONG  = color.new(color.green, 95)
color C_BGSHORT = color.new(color.red, 95)

// Function to get the reference value
get_reference_value(values, length) =>
    ref_value = float(na)
    if length >= 1
        for i = 0 to length by 1
            if na(ref_value) or not na(values[i])
                ref_value := values[i]
                ref_value
    ref_value

// Function to count consecutive occurrences
count_consecutive_occurrences(condition, length) =>
    consecutive_count = 0
    for i = 1 to length by 1
        if condition[i - 1]
            consecutive_count := consecutive_count + 1
            consecutive_count
        else
            consecutive_count := consecutive_count + 0
            consecutive_count
    consecutive_count

// Function to check if there is any occurrence
check_occurrence(condition, length) =>
    occurrence = count_consecutive_occurrences(condition, length) != 0
    occurrence

// Function to filter occurrences
filter_occurrences(condition, lookback_period) =>
    output = 0.0
    temp_counter = 0
    for i = lookback_period to 0 by 1
        if temp_counter > 0
            output := 0.0
            temp_counter := temp_counter[1] - 1
            temp_counter
        else
            if condition[i] == false
                output := 0.0
                output
            else
                output := 1.0
                // here temp_counter = lookback_period + 1 to increase accuracy, without "+1", it may impact accuracy
                temp_counter := lookback_period + 1
                temp_counter
    output_bool = output == 1 ? true : false
    output_bool

// Magic-9 Sequential
refOffset   = input.int(4, 'Reference Offset (close vs close[N])', minval = 1, maxval = 20, group = GRP_SEQ)
seqLenMinor = input.int(9, 'Minor Sequence Length', minval = 2, maxval = 50, group = GRP_SEQ, tooltip = 'Original value: 9')
seqLenMajor = input.int(13, 'Major Sequence Length', minval = 2, maxval = 50, group = GRP_SEQ, tooltip = 'Original value: 13')

// Wrappers identical to the original inline expressions (DRY, zero behavior change)
seq_complete_up(len) =>
    count_consecutive_occurrences(close > get_reference_value(close, refOffset), len) == len and count_consecutive_occurrences(close > get_reference_value(close, refOffset), len + 1) == len

seq_complete_dn(len) =>
    count_consecutive_occurrences(close < get_reference_value(close, refOffset), len) == len and count_consecutive_occurrences(close < get_reference_value(close, refOffset), len + 1) == len

high_5  = seq_complete_up(5)
high_6  = seq_complete_up(6)
high_7  = seq_complete_up(7)
high_8  = seq_complete_up(8)
high_9  = seq_complete_up(seqLenMinor)
high_12 = seq_complete_up(12)
high_13 = seq_complete_up(seqLenMajor)

low_5  = seq_complete_dn(5)
low_6  = seq_complete_dn(6)
low_7  = seq_complete_dn(7)
low_8  = seq_complete_dn(8)
low_9  = seq_complete_dn(seqLenMinor)
low_12 = seq_complete_dn(12)
low_13 = seq_complete_dn(seqLenMajor)

color_green = color.new(color.lime, 50)
color_red = color.new(color.red, 50)

// Magic-9 Highlights
period               = input.int(13, 'Period', minval = 2, maxval = 200, group = GRP_HL)
overbought_threshold = input.float(70, 'OB threshold', minval = 50, maxval = 100, step = 1, group = GRP_HL)
oversold_threshold   = input.float(30, 'OS threshold', minval = 0, maxval = 50, step = 1, group = GRP_HL)
occWin               = input.int(8, 'Occurrence Lookback', minval = 1, maxval = 50, group = GRP_HL, tooltip = 'Original value: 8')
suppressN            = input.int(13, 'Signal Suppression Period', minval = 0, maxval = 100, group = GRP_HL, tooltip = 'Original value: 13')
magic9_high_diff = high > high[1] ? high - high[1] : 0
magic9_low_diff  = low < low[1] ? low[1] - low : 0
magic9_high_avg  = ta.sma(magic9_high_diff, period)
magic9_low_avg   = ta.sma(magic9_low_diff, period)
magic9_denom     = magic9_high_avg + magic9_low_avg
magic9_index     = magic9_denom > 0 ? magic9_high_avg / magic9_denom * 100 : 50.0

// Raw BUY/SELL predicates (identical to V1; hoisted so each filter executes on every bar)
sellF9  = filter_occurrences(check_occurrence(high_9, occWin) and magic9_index > overbought_threshold, suppressN)
sellF13 = filter_occurrences(check_occurrence(high_13, occWin) and magic9_index > overbought_threshold, suppressN)
buyF9   = filter_occurrences(check_occurrence(low_9, occWin) and magic9_index < oversold_threshold, suppressN)
buyF13  = filter_occurrences(check_occurrence(low_13, occWin) and magic9_index < oversold_threshold, suppressN)
raw_sell_sig = sellF9 or sellF13
raw_buy_sig  = buyF9 or buyF13

// Signal Governance (state machine + exclusivity + cooldown + exits)
useStateMachine = input.bool(true, 'Use Position State Machine', group = GRP_SIG, tooltip = 'Off = legacy V1 behavior (entries only, no exits)')
useExclusivity  = input.bool(true, 'Same-bar Entry/Exit Exclusivity', group = GRP_SIG)
cooldownBars    = input.int(0, 'Cooldown Bars', minval = 0, maxval = 200, group = GRP_SIG, tooltip = '0 = off; Highlights suppression already spaces raw signals')
useExtremeExit  = input.bool(false, 'Extreme Anchor Exit (fallback)', group = GRP_SIG, tooltip = 'Exit long below N-bar lowest low / short above N-bar highest high')
extremeExitLen  = input.int(10, 'Extreme Exit Length', minval = 2, maxval = 100, group = GRP_SIG)
labelOffset     = input.int(1, 'BUY/SELL Label Offset (bars)', minval = 0, maxval = 5, group = GRP_SIG, tooltip = 'Original V1 placed labels 1 bar after the signal')

var int posState      = 0
var int lastSignalBar = na

cooldownOK   = na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars
extLow       = ta.lowest(low, extremeExitLen)
extHigh      = ta.highest(high, extremeExitLen)

rawLongEntry  = raw_buy_sig and posState <= 0 and cooldownOK
rawShortEntry = raw_sell_sig and posState >= 0 and cooldownOK
rawLongExit   = (raw_sell_sig or (useExtremeExit and close < extLow)) and posState == 1
rawShortExit  = (raw_buy_sig or (useExtremeExit and close > extHigh)) and posState == -1

longExit   = useExclusivity ? rawLongExit and not rawLongEntry and not rawShortEntry : rawLongExit
shortExit  = useExclusivity ? rawShortExit and not rawLongEntry and not rawShortEntry : rawShortExit
longEntry  = useExclusivity ? rawLongEntry and not longExit and not shortExit : rawLongEntry
shortEntry = useExclusivity ? rawShortEntry and not longExit and not shortExit : rawShortEntry

if useStateMachine
    if longEntry
        posState := 1
        lastSignalBar := bar_index
    else if shortEntry
        posState := -1
        lastSignalBar := bar_index
    else if longExit or shortExit
        posState := 0
        lastSignalBar := bar_index
else
    if longEntry or shortEntry or longExit or shortExit
        lastSignalBar := bar_index

// Re-entry (RL/RS, optional, default off)
useReentry = input.bool(false, 'Enable Re-entry (RL/RS)', group = GRP_SIG)
reentryWin = input.int(1, 'Anchor Window Around Exit Bar', minval = 1, maxval = 10, group = GRP_SIG)

var float exitHighAnchor = na
var float exitLowAnchor  = na
var bool  reentryArmed   = false

anchorHi = ta.highest(high, reentryWin * 2 + 1)
anchorLo = ta.lowest(low, reentryWin * 2 + 1)

if useReentry and (longExit or shortExit)
    exitHighAnchor := anchorHi
    exitLowAnchor  := anchorLo
    reentryArmed   := true
if useReentry and (longEntry or shortEntry)
    reentryArmed := false

RL = useReentry and reentryArmed and cooldownOK and posState == 0 and close > exitHighAnchor and not (close < exitLowAnchor)
RS = useReentry and reentryArmed and cooldownOK and posState == 0 and close < exitLowAnchor and not (close > exitHighAnchor)
if RL or RS
    reentryArmed := false
    lastSignalBar := bar_index
    if useStateMachine
        posState := RL ? 1 : -1

// Risk: ATR-based TP/SL reference levels
useTPSL = input.bool(true, 'Show ATR TP/SL Levels', group = GRP_RSK)
atrLen  = input.int(14, 'ATR Length', minval = 1, maxval = 200, group = GRP_RSK)
slMult  = input.float(2.0, 'Stop Loss (xATR)', minval = 0.5, maxval = 10, step = 0.25, group = GRP_RSK)
tpMult  = input.float(3.0, 'Take Profit (xATR)', minval = 0.5, maxval = 10, step = 0.25, group = GRP_RSK)

atrVal = ta.atr(atrLen)
var float entryPrice = na
var int   entryDir   = 0
var float slPrice    = na
var float tpPrice    = na

if longEntry or RL
    entryPrice := close
    entryDir   := 1
if shortEntry or RS
    entryPrice := close
    entryDir   := -1
if longExit or shortExit
    entryPrice := na
    entryDir   := 0
    slPrice    := na
    tpPrice    := na
if useTPSL and not na(entryPrice) and not na(atrVal)
    slPrice := entryPrice - entryDir * slMult * atrVal
    tpPrice := entryPrice + entryDir * tpMult * atrVal

plot(useTPSL ? slPrice : na, 'Stop Loss', color = color.new(color.red, 0), style = plot.style_linebr, force_overlay = true)
plot(useTPSL ? tpPrice : na, 'Take Profit', color = color.new(color.teal, 0), style = plot.style_linebr, force_overlay = true)

cooldownLeft = cooldownBars == 0 or na(lastSignalBar) ? 0 : math.max(0, cooldownBars - (bar_index - lastSignalBar))
plot(posState, 'Position State', display = display.data_window)

// Visual
showSeq     = input.bool(true, 'Show Sequential Counters', group = GRP_VIS)
showSigLbl  = input.bool(true, 'Show BUY/SELL Labels', group = GRP_VIS)
showExitLbl = input.bool(true, 'Show Exit Labels (XL/XS)', group = GRP_VIS)
showReLbl   = input.bool(true, 'Show Re-entry Labels (RL/RS)', group = GRP_VIS)
showHLbg    = input.bool(true, 'Show OB/OS Background', group = GRP_VIS)
showPosBg   = input.bool(true, 'Show Position Background', group = GRP_VIS)
showIndex   = input.bool(true, 'Show Magic-9 Index Pane', group = GRP_VIS)
showDash    = input.bool(true, 'Show Dashboard', group = GRP_VIS)

plotchar(high_5 and showSeq, char = '5', color = color_green)
plotchar(high_6 and showSeq, char = '6', color = color_green)
plotchar(high_7 and showSeq, char = '7', color = color_green)
plotchar(high_8 and showSeq, char = '8', color = color_green)
plotchar(high_12 and showSeq, char = '12', color = color_green)
plotshape(high_9 and showSeq, text = '9\n▼', style = shape.labeldown, location = location.abovebar, color = color.new(color.green, 20), textcolor = color.new(color.white, 0), offset = 0)
plotshape(high_9 and showSeq, text = '9\n▼', style = shape.labeldown, location = location.abovebar, color = color.new(color.white, 100), textcolor = color_green, offset = 0)
plotshape(high_13 and showSeq, text = '13\n▼', style = shape.labeldown, location = location.abovebar, color = color.new(color.green, 0), textcolor = color.new(color.white, 0), offset = 0)
plotshape(high_13 and showSeq, text = '13\n▼', style = shape.labeldown, location = location.abovebar, color = color.new(color.white, 100), textcolor = color_green, offset = 0)
plotchar(low_5 and showSeq, char = '5', color = color_red)
plotchar(low_6 and showSeq, char = '6', color = color_red)
plotchar(low_7 and showSeq, char = '7', color = color_red)
plotchar(low_8 and showSeq, char = '8', color = color_red)
plotchar(low_12 and showSeq, char = '12', color = color_red)
plotshape(low_9 and showSeq, text = '▲\n9', style = shape.labeldown, location = location.belowbar, color = color.new(color.red, 20), textcolor = color.new(color.white, 0), offset = 0)
plotshape(low_9 and showSeq, text = '▲\n9', style = shape.labeldown, location = location.belowbar, color = color.new(color.white, 100), textcolor = color_red, offset = 0)
plotshape(low_13 and showSeq, text = '▲\n13', style = shape.labeldown, location = location.belowbar, color = color.new(color.red, 0), textcolor = color.new(color.white, 0), offset = 0)
plotshape(low_13 and showSeq, text = '▲\n13', style = shape.labeldown, location = location.belowbar, color = color.new(color.white, 100), textcolor = color_red, offset = 0)

if showSigLbl and raw_buy_sig[labelOffset]
    label.new(bar_index, low, 'BUY', color = C_LONG, textcolor = color.white, style = label.style_label_up, yloc = yloc.price, size = size.small)
if showSigLbl and raw_sell_sig[labelOffset]
    label.new(bar_index, high, 'SELL', color = C_SHORT, textcolor = color.white, style = label.style_label_down, yloc = yloc.price, size = size.small)
if showExitLbl and longExit
    label.new(bar_index, high, 'XL', style = label.style_xcross, color = C_EXIT, textcolor = color.white, size = size.tiny)
if showExitLbl and shortExit
    label.new(bar_index, low, 'XS', style = label.style_xcross, color = C_EXIT, textcolor = color.white, size = size.tiny)
if showReLbl and RL
    label.new(bar_index, low, 'RL', style = label.style_label_up, color = C_REL, textcolor = color.white, size = size.tiny)
if showReLbl and RS
    label.new(bar_index, high, 'RS', style = label.style_label_down, color = C_RES, textcolor = color.white, size = size.tiny)

bgcolor(showHLbg and magic9_index > overbought_threshold ? color.new(color.fuchsia, 85) : na)
bgcolor(showHLbg and magic9_index < oversold_threshold ? color.new(color.yellow, 85) : na)
bgcolor(showPosBg and posState == 1 ? C_BGLONG : showPosBg and posState == -1 ? C_BGSHORT : na)

// plot(showIndex ? magic9_index : na, 'Magic-9 Index', color = color.new(color.teal, 0), linewidth = 2, force_overlay = false)
// plot(showIndex ? overbought_threshold : na, 'Index OB Level', color = color.new(color.fuchsia, 40), style = plot.style_linebr, force_overlay = false)
// plot(showIndex ? oversold_threshold : na, 'Index OS Level', color = color.new(color.yellow, 40), style = plot.style_linebr, force_overlay = false)
// plot(showIndex ? 50 : na, 'Index Mid Level', color = color.new(color.gray, 60), style = plot.style_linebr, force_overlay = false)

var table dash = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 60), border_width = 1)
if showDash and barstate.islast
    table.cell(dash, 0, 0, 'Position', text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 0, posState == 1 ? 'LONG' : posState == -1 ? 'SHORT' : 'FLAT', text_color = posState == 1 ? color.lime : posState == -1 ? color.red : color.gray, text_size = size.tiny)
    table.cell(dash, 0, 1, 'Magic-9 Index', text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 1, na(magic9_index) ? 'n/a' : str.tostring(magic9_index, '#.0'), text_color = color.white, text_size = size.tiny)
    table.cell(dash, 0, 2, 'Zone', text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 2, magic9_index > overbought_threshold ? 'OVERBOUGHT' : magic9_index < oversold_threshold ? 'OVERSOLD' : 'NEUTRAL', text_color = magic9_index > overbought_threshold ? color.fuchsia : magic9_index < oversold_threshold ? color.yellow : color.gray, text_size = size.tiny)
    table.cell(dash, 0, 3, 'Cooldown Left', text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 3, str.tostring(cooldownLeft), text_color = color.white, text_size = size.tiny)
    table.cell(dash, 0, 4, 'Take Profit', text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 4, useTPSL and not na(tpPrice) ? str.tostring(tpPrice, format.mintick) : 'n/a', text_color = color.teal, text_size = size.tiny)
    table.cell(dash, 0, 5, 'Stop Loss', text_color = color.white, text_size = size.tiny)
    table.cell(dash, 1, 5, useTPSL and not na(slPrice) ? str.tostring(slPrice, format.mintick) : 'n/a', text_color = color.red, text_size = size.tiny)

// Alerts
if longEntry
    alert('Magic-9 BUY (long entry) @ ' + str.tostring(close), alert.freq_once_per_bar_close)
if shortEntry
    alert('Magic-9 SELL (short entry) @ ' + str.tostring(close), alert.freq_once_per_bar_close)
if longExit
    alert('Magic-9 long exit (XL) @ ' + str.tostring(close), alert.freq_once_per_bar_close)
if shortExit
    alert('Magic-9 short exit (XS) @ ' + str.tostring(close), alert.freq_once_per_bar_close)
if RL
    alert('Magic-9 re-entry long (RL) @ ' + str.tostring(close), alert.freq_once_per_bar_close)
if RS
    alert('Magic-9 re-entry short (RS) @ ' + str.tostring(close), alert.freq_once_per_bar_close)
alertcondition(longEntry, 'Long Entry (BUY)', 'Magic-9 BUY signal on {{ticker}} {{interval}} @ {{close}}')
alertcondition(shortEntry, 'Short Entry (SELL)', 'Magic-9 SELL signal on {{ticker}} {{interval}} @ {{close}}')
alertcondition(longExit, 'Long Exit (XL)', 'Magic-9 long exit signal on {{ticker}} {{interval}} @ {{close}}')
alertcondition(shortExit, 'Short Exit (XS)', 'Magic-9 short exit signal on {{ticker}} {{interval}} @ {{close}}')
alertcondition(RL, 'Re-entry Long (RL)', 'Magic-9 RL re-entry signal on {{ticker}} {{interval}} @ {{close}}')
alertcondition(RS, 'Re-entry Short (RS)', 'Magic-9 RS re-entry signal on {{ticker}} {{interval}} @ {{close}}')
alertcondition(high_9, 'Sequential Up-9', '9 consecutive up closes (up-sequence) on {{ticker}} {{interval}}')
alertcondition(high_13, 'Sequential Up-13', '13 consecutive up closes (up-sequence) on {{ticker}} {{interval}}')
alertcondition(low_9, 'Sequential Down-9', '9 consecutive down closes (down-sequence) on {{ticker}} {{interval}}')
alertcondition(low_13, 'Sequential Down-13', '13 consecutive down closes (down-sequence) on {{ticker}} {{interval}}')
